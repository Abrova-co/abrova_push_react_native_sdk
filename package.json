{
  "name": "@abrova/push-react-native",
  "version": "0.1.19",
  "description": "Push notification SDK for React Native with in-app messages - Firebase alternative that works everywhere",
  "main": "src/index.ts",
  "types": "src/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "README.md",
    "LICENSE",
    "src",
    "android/src",
    "android/build.gradle",
    "ios",
    "react-native.config.js",
    "abrova-push-react-native.podspec",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "typescript": "tsc --noEmit",
    "version-sync": "node scripts/sync-version.js",
    "version-check": "node scripts/sync-version.js --check",
    "version": "node scripts/sync-version.js && git add src/version.ts",
    "prepublishOnly": "node scripts/sync-version.js --check",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "rm -rf node_modules",
    "example": "yarn --cwd example"
  },
  "keywords": [
    "react-native",
    "push-notifications",
    "mqtt",
    "firebase-alternative",
    "abrova-push",
    "voip",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abrova-co/abrova_push_react_native_sdk.git"
  },
  "author": "Abrova <support@abrova.ir>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Abrova-co/abrova_push_react_native_sdk/issues"
  },
  "homepage": "https://abrova.ir/cloud/abrova-push",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "react": "18.2.0",
    "react-native": "0.73.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  }
}
